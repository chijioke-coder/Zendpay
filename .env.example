# Copy to .env for local Postgres testing, and add the same names in
# Vercel > Project > Settings > Environment Variables.

# Supabase > Project Settings > Database > Connection string > "Transaction pooler" (port 6543).
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# Long random string used to sign login cookies. Generate: python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# Used ONLY to create the single owner account the first time the app runs (if none exists).
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=choose-a-strong-password

# Hours from UTC for displayed times (Lagos = 1)
ZENDPAY_TZ_OFFSET=1
